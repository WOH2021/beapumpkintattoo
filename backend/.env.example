PORT=3001

# PostgreSQL Database
# Use the Supabase "Connection string (URI)" from Project → Settings → Database
DATABASE_URL=postgresql://user:password@db.host:5432/database

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_from_supabase

# Admin Password for content management API
# Keep this SECURE - use a strong password (16+ chars with mixed case, numbers, symbols)
ADMIN_PASSWORD=YourSuperSecurePassword123!@#

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,https://beapumpkintattoo.com,https://www.beapumpkintattoo.com

# Environment
NODE_ENV=development

